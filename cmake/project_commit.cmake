INCLUDE_GUARD(GLOBAL)

# The commit the build comes from, reported by --version and read at configure
# time from the git checkout of this project; "-dirty" marks uncommitted changes,
# "unknown" a source tree that is not a git checkout of its own. A new commit
# or index change makes the build reconfigure. -DSTACK_SAMPLER_COMMIT=<id>
# sets the value for a tree without git.
SET(STACK_SAMPLER_COMMIT "" CACHE STRING "Commit to report when the source tree has no git")
SET(PROJECT_COMMIT "${STACK_SAMPLER_COMMIT}")
FIND_PACKAGE(Git QUIET)
IF(PROJECT_COMMIT STREQUAL "" AND GIT_FOUND)
    EXECUTE_PROCESS(COMMAND "${GIT_EXECUTABLE}" -C "${PROJECT_SOURCE_DIR}" rev-parse --show-toplevel
        OUTPUT_VARIABLE GIT_TOPLEVEL RESULT_VARIABLE GIT_RESULT OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    IF(GIT_RESULT EQUAL 0)
        FILE(REAL_PATH "${GIT_TOPLEVEL}" GIT_TOPLEVEL)
        FILE(REAL_PATH "${PROJECT_SOURCE_DIR}" PROJECT_ROOT)
    ENDIF()
    IF(GIT_RESULT EQUAL 0 AND GIT_TOPLEVEL STREQUAL PROJECT_ROOT)
        EXECUTE_PROCESS(COMMAND "${GIT_EXECUTABLE}" -C "${PROJECT_SOURCE_DIR}" rev-parse --short=12 HEAD
            OUTPUT_VARIABLE PROJECT_COMMIT OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
        EXECUTE_PROCESS(COMMAND "${GIT_EXECUTABLE}" -C "${PROJECT_SOURCE_DIR}" status --porcelain --untracked-files=no
            OUTPUT_VARIABLE GIT_CHANGES OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
        IF(NOT GIT_CHANGES STREQUAL "")
            STRING(APPEND PROJECT_COMMIT "-dirty")
        ENDIF()
        FOREACH(GIT_PATH HEAD index packed-refs)
            EXECUTE_PROCESS(COMMAND "${GIT_EXECUTABLE}" -C "${PROJECT_SOURCE_DIR}" rev-parse --path-format=absolute
                --git-path ${GIT_PATH} OUTPUT_VARIABLE GIT_FILE OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
            IF(EXISTS "${GIT_FILE}")
                SET_PROPERTY(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${GIT_FILE}")
            ENDIF()
        ENDFOREACH()
        EXECUTE_PROCESS(COMMAND "${GIT_EXECUTABLE}" -C "${PROJECT_SOURCE_DIR}" symbolic-ref -q HEAD
            OUTPUT_VARIABLE GIT_BRANCH OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
        IF(NOT GIT_BRANCH STREQUAL "")
            EXECUTE_PROCESS(COMMAND "${GIT_EXECUTABLE}" -C "${PROJECT_SOURCE_DIR}" rev-parse --path-format=absolute
                --git-path ${GIT_BRANCH} OUTPUT_VARIABLE GIT_FILE OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
            IF(EXISTS "${GIT_FILE}")
                SET_PROPERTY(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${GIT_FILE}")
            ENDIF()
        ENDIF()
    ENDIF()
ENDIF()
IF(PROJECT_COMMIT STREQUAL "")
    SET(PROJECT_COMMIT "unknown")
ENDIF()
MESSAGE(STATUS "${PROJECT_NAME} ${PROJECT_VERSION}, commit ${PROJECT_COMMIT}")
